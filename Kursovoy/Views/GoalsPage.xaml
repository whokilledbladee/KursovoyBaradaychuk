<UserControl x:Class="Kursovoy.Views.GoalsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <Grid Background="White" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <Button Content="➕ Добавить" 
                    Click="AddGoal_Click" 
                    Style="{StaticResource ActionButtonStyle}"
                    Margin="0,0,10,0"/>
            <Button Content="✏️ Редактировать" 
                    Click="EditGoal_Click"
                    Style="{StaticResource ActionButtonStyle}"
                    Margin="0,0,10,0"/>
            <Button Content="❌ Удалить" 
                    Click="DeleteGoal_Click"
                    Style="{StaticResource ActionButtonStyle}"/>
        </StackPanel>

        <ListBox Grid.Row="1" x:Name="GoalsListBox" BorderThickness="0" Background="Transparent">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="5" 
                            Margin="0,0,0,10" Padding="15" Background="#F8F9FA">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="{Binding Name}" 
                                      FontSize="16" FontWeight="Bold" 
                                      Foreground="#2C3E50" Margin="0,0,0,5"/>

                            <Border Grid.Row="1" Background="#ECF0F1" Height="20" 
                                    CornerRadius="10" Margin="0,5,0,5">
                                <Border Background="#27AE60" Height="20" 
                                        CornerRadius="10" HorizontalAlignment="Left"
                                        Width="{Binding ProgressWidth}"/>
                            </Border>

                            <StackPanel Grid.Row="2" Orientation="Horizontal">
                                <TextBlock Text="{Binding CurrentAmount, StringFormat={}{0:# ### ### ###} р.}" 
                                FontWeight="SemiBold" Foreground="#27AE60"/>
                                <TextBlock Text=" из " Margin="5,0,5,0" Foreground="#7F8C8D"/>
                                <TextBlock Text="{Binding TargetAmount, StringFormat={}{0:# ### ### ###} р.}" 
                                FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding ProgressPercentage, StringFormat={} ({0:F0}%)}" 
                                Margin="10,0,0,0" FontWeight="SemiBold" 
                                Foreground="#7F8C8D"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>