<UserControl x:Class="Kursovoy.Views.TransactionsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <Grid Background="White" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="История операций" 
                      FontSize="18" 
                      FontWeight="Bold" 
                      Foreground="#2C3E50"
                      Margin="0,0,0,10"/>

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Счет:" 
                          VerticalAlignment="Center" 
                          Margin="0,0,10,0"/>
                <ComboBox x:Name="AccountFilterComboBox" 
                         Width="150" 
                         Margin="0,0,20,0"
                         SelectionChanged="AccountFilter_SelectionChanged">
                    <ComboBoxItem Content="Все счета" IsSelected="True"/>
                </ComboBox>

                <TextBlock Text="Тип:" 
                          VerticalAlignment="Center" 
                          Margin="0,0,10,0"/>
                <ComboBox x:Name="TypeFilterComboBox" 
                         Width="120"
                         SelectionChanged="TypeFilter_SelectionChanged">
                    <ComboBoxItem Content="Все" IsSelected="True"/>
                    <ComboBoxItem Content="Доходы"/>
                    <ComboBoxItem Content="Расходы"/>
                </ComboBox>

                <Button Content="Сбросить фильтры" 
                       Click="ClearFilters_Click"
                       Margin="20,0,0,0"
                       Style="{StaticResource ActionButtonStyle}"
                       Padding="10,5"/>
            </StackPanel>
        </StackPanel>

        <ListView Grid.Row="1" x:Name="TransactionsListView">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Дата" Width="120" 
                                   DisplayMemberBinding="{Binding DisplayDate}"/>
                    <GridViewColumn Header="Счет" Width="120" 
                                   DisplayMemberBinding="{Binding AccountName}"/>
                    <GridViewColumn Header="Тип" Width="80" 
                                   DisplayMemberBinding="{Binding DisplayType}"/>
                    <GridViewColumn Header="Сумма" Width="100" 
                                   DisplayMemberBinding="{Binding DisplayAmount}"/>
                    <GridViewColumn Header="Категория" Width="120" 
                                   DisplayMemberBinding="{Binding Category}"/>
                    <GridViewColumn Header="Описание" Width="200" 
                                   DisplayMemberBinding="{Binding Description}"/>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</UserControl>