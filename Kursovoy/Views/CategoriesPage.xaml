<UserControl x:Class="Kursovoy.Views.CategoriesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Kursovoy.Views"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Базовые категории" 
                      FontSize="18" 
                      FontWeight="Bold" 
                      Foreground="#2C3E50"/>
            <TextBlock Text="Предустановленные категории для быстрого начала работы" 
                      FontSize="12" 
                      Foreground="#7F8C8D"
                      Margin="0,5,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="#E8F5E8" CornerRadius="5" Padding="15" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="💰 ДОХОДЫ" 
                                  FontWeight="Bold" 
                                  FontSize="14" 
                                  Foreground="#27AE60"
                                  Margin="0,0,0,10"/>

                        <ItemsControl x:Name="IncomeCategoriesList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" 
                                            CornerRadius="3" 
                                            Padding="10,8" 
                                            Margin="0,2">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Icon}" 
                                                      FontSize="14" 
                                                      Margin="0,0,10,0"/>
                                            <TextBlock Text="{Binding Name}" 
                                                      VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Background="#FEE" CornerRadius="5" Padding="15">
                    <StackPanel>
                        <TextBlock Text="💸 РАСХОДЫ" 
                                  FontWeight="Bold" 
                                  FontSize="14" 
                                  Foreground="#E74C3C"
                                  Margin="0,0,0,10"/>

                        <ItemsControl x:Name="ExpenseCategoriesList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" 
                                            CornerRadius="3" 
                                            Padding="10,8" 
                                            Margin="0,2">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Icon}" 
                                                      FontSize="14" 
                                                      Margin="0,0,10,0"/>
                                            <TextBlock Text="{Binding Name}" 
                                                      VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

    </Grid>
</UserControl>