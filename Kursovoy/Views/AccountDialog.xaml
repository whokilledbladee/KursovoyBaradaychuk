<Window x:Class="Kursovoy.Views.AccountDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавить счет" Height="300" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Название счета -->
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Название:" 
                  Margin="0,0,10,10" VerticalAlignment="Center"/>
        <TextBox Grid.Row="0" Grid.Column="1" x:Name="NameTextBox" 
                Margin="0,0,0,10" Height="25"/>

        <!-- Тип счета -->
        <TextBlock Grid.Row="1" Grid.Column="0" Text="Тип счета:" 
                  Margin="0,0,10,10" VerticalAlignment="Center"/>
        <ComboBox Grid.Row="1" Grid.Column="1" x:Name="TypeComboBox"
                 Margin="0,0,0,10" Height="25"/>

        <!-- Начальный баланс -->
        <TextBlock Grid.Row="2" Grid.Column="0" Text="Начальный баланс:" 
                  Margin="0,0,10,10" VerticalAlignment="Center"/>
        <TextBox Grid.Row="2" Grid.Column="1" x:Name="BalanceTextBox" 
                Margin="0,0,0,10" Height="25" Text="0"/>

        <!-- Валюта -->
        <TextBlock Grid.Row="3" Grid.Column="0" Text="Валюта:" 
                  Margin="0,0,10,10" VerticalAlignment="Center"/>
        <ComboBox Grid.Row="3" Grid.Column="1" x:Name="CurrencyComboBox"
                 Margin="0,0,0,10" Height="25" SelectedIndex="0">
            <ComboBoxItem Content="RUB (Рубли)"/>
            <ComboBoxItem Content="USD (Доллары)"/>
            <ComboBoxItem Content="EUR (Евро)"/>
        </ComboBox>

        <!-- Кнопки -->
        <StackPanel Grid.Row="5" Grid.ColumnSpan="2" 
                   Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Сохранить" Click="SaveButton_Click" 
                   Width="80" Margin="0,0,10,0" Style="{StaticResource ActionButtonStyle}"/>
            <Button Content="Отмена" Click="CancelButton_Click" 
                   Width="80" Style="{StaticResource ActionButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>