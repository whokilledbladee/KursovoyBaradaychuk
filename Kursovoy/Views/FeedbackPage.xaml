<UserControl x:Class="Kursovoy.Views.FeedbackPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="800">

    <Grid Background="White" Margin="10">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="Обратная связь" 
                          FontSize="24" 
                          FontWeight="Bold" 
                          Foreground="#2C3E50"
                          Margin="0,0,0,20"/>

                <Border BorderBrush="#BDC3C7" 
                       BorderThickness="1" 
                       CornerRadius="10" 
                       Padding="20" 
                       Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Контактная информация" 
                                  FontSize="18" 
                                  FontWeight="Bold" 
                                  Foreground="#2C3E50"
                                  Margin="0,0,0,15"/>

                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="Разработчик:" 
                                      FontWeight="SemiBold" 
                                      Foreground="#3498DB"/>
                            <TextBlock Text="Барадайчук Д.К." 
                                      Margin="0,5,0,0"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="Связь:" 
                                      FontWeight="SemiBold" 
                                      Foreground="#3498DB"/>
                            <TextBlock Text="• Email: support@financemanager.ru" 
                                      Margin="0,5,0,2"/>
                            <TextBlock Text="• Telegram: @finance_manager_support" 
                                      Margin="0,0,0,2"/>
                            <TextBlock Text="• VK: vk.com/finance_manager" 
                                      Margin="0,0,0,0"/>
                        </StackPanel>

                        <StackPanel Margin="0,15,0,0">
                            <TextBlock Text="Время поддержки:" 
                                      FontWeight="SemiBold" 
                                      Foreground="#3498DB"/>
                            <TextBlock Text="Понедельник - Пятница: 9:00 - 18:00" 
                                      Margin="0,5,0,0"/>
                            <TextBlock Text="Суббота - Воскресенье: выходной" 
                                      Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border BorderBrush="#BDC3C7" 
                       BorderThickness="1" 
                       CornerRadius="10" 
                       Padding="20" Height="140">
                    <StackPanel Height="97">
                        <TextBlock Text="Мы рады вашим пожеланиям!" 
                                  FontSize="18" 
                                  FontWeight="Bold" 
                                  Foreground="#2C3E50"
                                  Margin="0,0,0,15"/>

                        <TextBlock Text="Мы всегда открыты для предложений по улучшению нашего приложения." 
                                  TextWrapping="Wrap"
                                  Margin="0,0,0,10"/>

                        <TextBlock Text="Если у вас есть идеи, замечания или пожелания по функционалу, дизайну или удобству использования, пожалуйста, свяжитесь с нами по указанным выше контактам." 
                                  TextWrapping="Wrap"
                                  Margin="0,0,0,15" Height="41"/>

                        <TextBlock Text="Ваше мнение очень важно для нас и поможет сделать приложение лучше!" 
                                  TextWrapping="Wrap"
                                  FontStyle="Italic"
                                  Foreground="#27AE60"/>
                    </StackPanel>
                </Border>


            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>